{
    "name": "treasure-island-service",
    "version": "1.0.0",
    "description": "",
    "main": "./src/app.js",
    "scripts": {
        "test": "jest",
        "test-coverage": "jest --collect-coverage --testPathPattern=tests/unit-tests",
        "dev": "nodemon --es-module-specifier-resolution=node --watch ./src ./src/app.js",
        "debug": "nodemon --es-module-specifier-resolution=node --watch ./ --inspect ./src/app.js",
        "prod": "node --max-old-space-size=8192 --es-module-specifier-resolution=node ./src/app.js",
        "reg": "npm set registry http://npm.lumigame.com",
        "integration-test": "jest tests/integration-tests/index.test.js --ci --reporters=default --reporters=jest-junit --forceExit"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "pentagon",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "mongoose": "8.4.1",
        "sc-card-game-base": "1.2.1-beta.7",
        "sc-multiple-games-base": "1.9.1-beta.6",
        "sc-rebet-mode": "2.0.2-beta.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.24.4",
        "@commitlint/cli": "^19.2.2",
        "@commitlint/config-conventional": "^19.2.2",
        "@types/jest": "^29.5.12",
        "babel-jest": "^29.7.0",
        "babel-plugin-rewire": "^1.2.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^29.7.0",
        "jest-extended": "^4.0.2",
        "jest-html-reporters": "^3.1.7",
        "jest-junit": "^16.0.0",
        "jest-micro-auto-stub": "1.0.9",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^3.1.0",
        "sc-game-service-integration-utils": "2.2.0"
    },
    "resolutions": {
        "sc-base-database": "2.2.1-beta.1",
        "mongoose": "8.4.1",
        "sc-game-base": "5.2.0-beta.1"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
